// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  PENDING
  FRIENDS
}

model User {
  id Int @id @default(autoincrement())
  password String?
  email String @unique 
  username String @unique
  aboutMe String?
  avatar String?
  joinedAt DateTime @default(now())
  posts Post[]
  comments Comment[]
  likes Like[]
  upvotes Upvote[]

  githubId String? @unique
  googleId String? @unique

  sentFriendRequest Friend[] @relation("Sender")
  receivedFriendRequest Friend[] @relation("Receiver")
  @@map("users")
}

model Post {
  id Int @id @default(autoincrement())
  title String 
  content String 
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int

  postImages PostImage[]
  comments Comment[]
  likes Like[]
  @@map("posts")
}

model PostImage {
  id Int @id @default(autoincrement())
  url String 
  
  postId Int 
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_images")
}
//might add upvote for comments
model Comment {
  id Int @id @default(autoincrement())
  text String
  upvotes Upvote[]

  commenterId Int
  commenter User @relation(fields: [commenterId], references: [id], onDelete: Cascade)

  postId Int 
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Upvote {
  commentId Int 
  comment Comment @relation(fields: [commentId], references: [id])
  userId Int 
  upvoter User @relation(fields: [userId], references: [id])

  @@id([userId, commentId])
  @@map("upvotes")
}

model Like {
  userId Int
  postId Int 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
 
  @@id([userId, postId])
  @@map("likes")
}

model Friend {
  id Int @id @default(autoincrement())

  userId Int
  friendId Int

  createdAt DateTime @default(now())
  status Status @default(PENDING)

  sender User @relation("Sender", fields: [userId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@map("friends")
}

